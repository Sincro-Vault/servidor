# JWT
JWT_SECRET_KEY=EstaEsUnaClaveSuperSecretaServidor2026!
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10

# Database
DATABASE_URL=sqlite:///./server.db

# Server ports
REST_HOST=0.0.0.0
REST_PORT=9000
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# TLS (paths to PEM files for gRPC)
TLS_ENABLED=false
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key

# Blockchain
BLOCKCHAIN_DIFFICULTY=2
BLOCKCHAIN_LEDGER_PATH=./data/ledger.json
